import { createClient } from '@supabase/supabase-js';
import { NextResponse } from 'next/server';
import nodemailer from 'nodemailer';

function renderHtmlEmail({
  title,
  content,
  buttonText,
  buttonUrl,
}: {
  title: string;
  content: string;
  buttonText?: string;
  buttonUrl?: string;
}) {
  const formattedContent = content
    .split('\n')
    .filter((line) => line.trim() !== '')
    .map((line) => `<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #374151;">${line}</p>`)
    .join('');

  const actionButton = buttonText && buttonUrl && buttonUrl !== '#' ? `
    <tr>
      <td align="center" style="padding: 24px 0 12px 0;">
        <a href="${buttonUrl}" target="_blank" style="background-color: #2563eb; color: #ffffff; display: inline-block; font-size: 14px; font-weight: 700; line-height: 1; padding: 14px 28px; text-decoration: none; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);">
          ${buttonText} →
        </a>
      </td>
    </tr>
  ` : '';

  return `
    <!DOCTYPE html>
    <html lang="tr">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>${title}</title>
    </head>
    <body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%" style="table-layout: fixed;">
        <tr>
          <td align="center" style="padding: 40px 16px;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; border: 1px solid #e5e7eb; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);">
              <tr>
                <td style="background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%); height: 6px;"></td>
              </tr>
              <tr>
                <td style="padding: 36px 32px;">
                  <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                      <td>
                        <h1 style="margin: 0 0 20px 0; font-size: 20px; font-weight: 800; color: #111827; letter-spacing: -0.025em;">
                          ${title}
                        </h1>
                      </td>
                    </tr>
                    <tr>
                      <td>${formattedContent}</td>
                    </tr>
                    ${actionButton}
                  </table>
                </td>
              </tr>
              <tr>
                <td style="background-color: #f9fafb; padding: 20px 32px; border-top: 1px solid #f3f4f6; text-align: center;">
                  <p style="margin: 0; font-size: 12px; color: #9ca3af;">
                    Bu e-posta size özel olarak gönderilmiştir.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </body>
    </html>
  `;
}

function getSupabaseClient() {
  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
  const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!;
  return createClient(supabaseUrl, supabaseKey);
}

// 1 Adet Mail Gönderim Fonksiyonu
async function sendSingleMail(supabase: any) {
  const { data: queueItem, error: queueErr } = await supabase
    .from('email_queue')
    .select('*, campaigns(*), contacts(*)')
    .eq('status', 'Bekliyor')
    .limit(1)
    .maybeSingle();

  if (queueErr || !queueItem) return null;

  const { data: smtp } = await supabase.from('smtp_settings').select('*').maybeSingle();
  if (!smtp) return null;

  const transporter = nodemailer.createTransport({
    host: smtp.host,
    port: Number(smtp.port) || 587,
    secure: Number(smtp.port) === 465,
    auth: {
      user: smtp.username,
      pass: smtp.password,
    },
    tls: { rejectUnauthorized: false }
  });

  const contact = queueItem.contacts;
  const contactName = contact?.first_name 
    ? `${contact.first_name} ${contact.last_name || ''}`.trim() 
    : 'Değerli Üyemiz';

  const campaign = queueItem.campaigns;
  const templates = campaign?.templates || [];
  const templateIndex = queueItem.template_index || 0;
  const selectedTemplate = templates[templateIndex] || templates[0];

  if (!selectedTemplate) {
    await supabase.from('email_queue').update({ status: 'Hata' }).eq('id', queueItem.id);
    return null;
  }

  const finalSubject = selectedTemplate.subject.replace(/\{\{ad_soyad\}\}/g, contactName);
  const finalContent = selectedTemplate.content.replace(/\{\{ad_soyad\}\}/g, contactName);

  const htmlBody = renderHtmlEmail({
    title: finalSubject,
    content: finalContent,
    buttonText: selectedTemplate.buttonText || 'Hemen Kaydol',
    buttonUrl: selectedTemplate.buttonUrl || 'https://www.cumhuriyeticinkos.com',
  });

  await transporter.sendMail({
    from: `"${smtp.username}" <${smtp.username}>`,
    to: contact.email,
    subject: finalSubject,
    text: finalContent,
    html: htmlBody,
  });

  await supabase.from('email_queue').update({ status: 'Gönderildi' }).eq('id', queueItem.id);
  return contact.email;
}

export async function GET() {
  const supabase = getSupabaseClient();

  // Türkiye Saatini Al (UTC+3)
  const now = new Date();
  const turkeyTime = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Istanbul' }));
  const hours = turkeyTime.getHours();
  const minutes = turkeyTime.getMinutes();
  const timeInMinutes = hours * 60 + minutes;

  // 09:00 (540 dk) ile 16:30 (990 dk) arasında değilse durdur
  if (timeInMinutes < 540 || timeInMinutes > 990) {
    return NextResponse.json({ message: 'Gönderim saatleri dışındayız. (Çalışma Saatleri: 09:00 - 16:30)' });
  }

  try {
    // 1. Maili Hemen Gönder (0. saniye)
    const firstMail = await sendSingleMail(supabase);

    // 30 Saniye Bekle
    await new Promise((resolve) => setTimeout(resolve, 30000));

    // 2. Maili Gönder (30. saniye)
    const secondMail = await sendSingleMail(supabase);

    return NextResponse.json({
      success: true,
      sentMails: [firstMail, secondMail].filter(Boolean),
      message: '30 saniye aralıkla 2 e-posta işlendi.'
    });

  } catch (err: any) {
    return NextResponse.json({ error: err?.message || 'İşlem hatası' }, { status: 500 });
  }
}